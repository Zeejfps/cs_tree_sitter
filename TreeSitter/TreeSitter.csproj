<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TreeSitter</RootNamespace>
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;linux-x64</RuntimeIdentifiers>
    <!--
      The boundary work this layer does for its callers: pinning the UTF-8 buffer
      for a parse, calling a grammar's exported accessor through a function
      pointer, and reading a match's capture array out of cursor-owned memory.
      Nothing above this project needs unsafe.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TreeSitter.Bindings\TreeSitter.Bindings.csproj" />
  </ItemGroup>

</Project>
